{
  "id": "meetTheCrew",
  "tutorial": true,
  "name": "First Contact",
  "description": "Locate your personal communicator and establish contact with ARIA, your executive officer.",
  "category": "tutorial",
  "priority": "high",
  "autoStart": true,
  "prerequisites": [],
  "objectives": [
    {
      "id": "find_communicator",
      "description": "Locate your communicator on your desk in your quarters",
      "required": true,
      "triggers": [
        {
          "type": "location_enter",
          "location": "quarters"
        }
      ],
      "onComplete": [
        {
          "type": "spawn_interactive",
          "elementId": "communicator_pickup",
          "location": "quarters_desk"
        }
      ]
    },
    {
      "id": "pickup_communicator",
      "description": "Pick up the communicator from your desk",
      "required": true,
      "triggers": [
        {
          "type": "item_pickup",
          "itemId": "communicator"
        }
      ],
      "onComplete": [
        {
          "type": "set_property",
          "property": "contacts.crew.captain.communicator",
          "value": true
        },
        {
          "type": "add_item",
          "itemId": "communicator",
          "quantity": 1
        },
        {
          "type": "show_dialogue",
          "characterId": "system",
          "dialogueId": "communicator_tutorial"
        }
      ],
      "after": "find_communicator"
    },
    {
      "id": "learn_communicator",
      "description": "Open your communicator (tap the badge, or press C)",
      "required": true,
      "triggers": [
        {
          "type": "property_change",
          "property": "tutorial.communicator_opened",
          "value": true
        }
      ],
      "onComplete": [
        {
          "type": "unlock_crew",
          "crewId": "executiveOfficer"
        }
      ],
      "after": "pickup_communicator"
    },
    {
      "id": "contact_area",
      "description": "Use the communicator to contact ARIA",
      "required": true,
      "triggers": [
        {
          "type": "dialogue_complete",
          "characterId": "executiveOfficer",
          "dialogueId": "first_contact"
        }
      ],
      "onComplete": [
        {
          "type": "add_contextual",
          "characterId": "executiveOfficer",
          "context": "first_meeting"
        }
      ],
      "after": "learn_communicator"
    }
  ],
  "onComplete": [
    {
      "type": "unlock_station",
      "station": "Communications"
    },
    {
      "type": "set_property",
      "property": "progress.tutorial_phase",
      "value": "communications_complete"
    },
    {
      "type": "start_mission",
      "missionId": "shipTour",
      "delaySeconds": 8
    }
  ],
  "followUpMissions": [],
  "rewards": {
    "experience": 100,
    "items": [
      {
        "id": "communicator_manual",
        "quantity": 1
      }
    ]
  },
  "hints": [
    {
      "condition": {
        "type": "objective_active_for",
        "objectiveId": "find_communicator",
        "seconds": 30
      },
      "message": "{captain}, your quarters are forward: out of the Launch Bay, along walkway AN-1 to A1, then the door on the right. Your communicator pin is on the desk, and your PED is on the bed."
    },
    {
      "condition": {
        "type": "objective_active_for",
        "objectiveId": "pickup_communicator",
        "seconds": 30
      },
      "message": "The pin is on the desk beside your laptop, {captain}. Tap it to pick it up."
    },
    {
      "condition": {
        "type": "objective_active_for",
        "objectiveId": "learn_communicator",
        "seconds": 45
      },
      "message": "Tap the badge in the top-right corner, {captain}. I will be listening."
    }
  ]
}
